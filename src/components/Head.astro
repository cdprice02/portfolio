---
import { getImage } from "astro:assets";
import { isPreview } from "../lib/build";
import { getProfile } from "../lib/profile";

export interface Props {
  title: string;
  description: string;
  /** Canonical path, or null for pages that shouldn't claim a URL (the 404 page). */
  path: string | null;
  image: { src: string; width: number; height: number; alt: string };
  /** Structured data for pages other than the Landing page. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, path, image, jsonLd: pageJsonLd } = Astro.props;
const site = Astro.site!;
const profile = await getProfile();
const canonical = path === null ? null : new URL(path, site).href;
const imageUrl = new URL(image.src, site).href;
const portrait = await getImage({
  src: profile.headshot,
  width: 512,
  format: "webp",
});

const landingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    // Project pages name the author by this id.
    "@id": new URL("/#person", site).href,
    name: profile.name,
    jobTitle: profile.role,
    url: site.href,
    image: new URL(portrait.src, site).href,
    email: profile.email,
    sameAs: [profile.github, profile.linkedin],
  },
};
---

<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{isPreview && <meta name="robots" content="noindex" />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="cdprice.dev" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
<meta property="og:image:alt" content={image.alt} />
<meta name="twitter:card" content="summary_large_image" />

<meta
  name="theme-color"
  content="#f6f7f9"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#0e1218"
  media="(prefers-color-scheme: dark)"
/>
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

{(path === "/" || pageJsonLd) && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(path === "/" ? landingJsonLd : pageJsonLd)}
  />
)}
