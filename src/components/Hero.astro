---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { getProfile } from "../lib/profile";

interface Props {
  profile: Awaited<ReturnType<typeof getProfile>>;
}

const { profile } = Astro.props;
const pill =
  "inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium text-fg no-underline hover:border-accent hover:text-accent";
---

<section class="flex flex-col gap-6" aria-labelledby="name">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-7">
    <Image
      src={profile.headshot}
      alt="Headshot of Carson Price"
      width={112}
      densities={[1, 2, 3]}
      format="webp"
      loading="eager"
      class="size-28 flex-none rounded-full shadow-[0_0_0_4px_var(--bg),0_0_0_6px_var(--accent)]"
    />
    <div class="flex min-w-0 flex-col gap-1.5">
      <h1 id="name" class="text-4xl font-bold tracking-tight sm:text-5xl">
        {profile.name}
      </h1>
      <p class="text-lg font-medium text-accent">{profile.role}</p>
      {profile.location && (
        <p class="flex items-center gap-1.5 font-mono text-xs text-muted">
          <Icon name="lucide:map-pin" aria-hidden="true" class="size-3.5" />
          {profile.location}
        </p>
      )}
    </div>
  </div>
  <p class="max-w-[62ch] text-[1.0625rem] leading-relaxed">{profile.intro}</p>
  <nav aria-label="Profile links" class="flex flex-wrap gap-2.5">
    <a
      href={profile.resume}
      class="inline-flex items-center gap-2 rounded-full bg-accent px-4 py-2 text-sm font-semibold text-bg no-underline hover:opacity-90"
    >
      <Icon name="lucide:file-text" aria-hidden="true" class="size-4" />
      Resume (PDF)
    </a>
    <a href={profile.github} class={pill}>
      <Icon name="simple-icons:github" aria-hidden="true" class="size-4" />
      GitHub
    </a>
    <a href={profile.linkedin} class={pill}>
      <Icon name="simple-icons:linkedin" aria-hidden="true" class="size-4" />
      LinkedIn
    </a>
    <a href={`mailto:${profile.email}`} class={pill}>
      <Icon name="lucide:mail" aria-hidden="true" class="size-4" />
      <span class="font-mono">{profile.email}</span>
    </a>
  </nav>
</section>
