---
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import MetaLine from "../../components/MetaLine.astro";
import Base from "../../layouts/Base.astro";
import { getChangelog, type ChangelogEntry } from "../../lib/changelog";
import {
  getPages,
  isoDate,
  transitionNames,
  type ProjectPage,
} from "../../lib/projects";

export async function getStaticPaths() {
  const [pages, changelog] = await Promise.all([getPages(), getChangelog()]);
  return pages.map((page) => ({
    params: { slug: page.project.id },
    props: { ...page, entries: changelog.get(page.project.id) ?? [] },
  }));
}

type Props = ProjectPage & { entries: ChangelogEntry[] };

const { project, updated, live, sections, entries } = Astro.props;
const {
  title,
  tagline,
  summary,
  repo,
  links = [],
  figures = [],
  caveat,
  status,
  tags,
} = project.data;
const { Content } = await render(project);
const changes = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Body: (await render(entry)).Content,
  })),
);
const toc = [
  ...sections,
  ...(changes.length > 0
    ? [{ slug: "recent-changes", text: "Recent changes" }]
    : []),
];
const sectionText = new Map(sections.map(({ slug, text }) => [slug, text]));
const pills = [
  ...links.map((link) => ({ ...link, icon: "lucide:external-link" })),
  { label: "Source on GitHub", href: repo, icon: "simple-icons:github" },
];

const path = `/projects/${project.id}/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: title,
  description: summary,
  codeRepository: repo,
  programmingLanguage: tags[0],
  dateModified: isoDate(updated),
  author: { "@id": new URL("/#person", Astro.site!).href },
};
---

<Base
  title={`${title} · Carson Price`}
  description={summary}
  path={path}
  image={{
    src: `/og/${project.id}.png`,
    width: 1200,
    height: 630,
    alt: `${title}, ${tagline}, cdprice.dev`,
  }}
  jsonLd={jsonLd}
>
  <style is:inline slot="head" set:html={transitionNames([project.id])} />

  <a
    href="/#projects"
    class="mb-6 inline-flex font-mono text-sm text-muted no-underline hover:text-accent"
  >
    ← projects
  </a>

  <header class="flex flex-col gap-2.5">
    <h1
      data-project={project.id}
      class="w-fit text-4xl leading-[1.1] font-bold tracking-tight sm:text-5xl"
    >
      {title}
    </h1>
    <p class="text-lg font-medium text-accent">{tagline}</p>
    <MetaLine
      status={status}
      updated={updated}
      lastCommit={new Date(live.lastCommit)}
      asOf={live.asOf}
    />
  </header>

  <section class="mt-7 flex flex-col gap-6" aria-label="Overview">
    <p class="max-w-[62ch] text-lg leading-[1.65]">{summary}</p>

    {figures.length > 0 && (
      <ul class="grid gap-3 min-[521px]:grid-cols-3" aria-label="Key figures">
        {figures.map(({ value, label, section }) => (
          <li>
            <a
              href={`#${section}`}
              class="group flex h-full flex-col gap-0.5 rounded-xl border border-line bg-surface px-4 py-3.5 text-fg no-underline hover:border-accent"
            >
              <span class="font-mono text-[1.75rem] leading-[1.2] font-medium text-accent">
                {value}
              </span>
              <span class="text-sm font-medium">{label}</span>
              <span class="mt-1.5 font-mono text-[0.6875rem] text-muted group-hover:text-accent">
                {sectionText.get(section)} →
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class="flex flex-col gap-2">
      <nav aria-label="Project links" class="flex flex-wrap gap-2.5">
        {pills.map(({ label, href, icon }, i) => (
          <a
            href={href}
            class:list={[
              "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm no-underline",
              i === 0
                ? "border-accent bg-accent font-semibold text-bg hover:opacity-90"
                : "border-line bg-surface font-medium text-fg hover:border-accent hover:text-accent",
            ]}
          >
            <Icon name={icon} aria-hidden="true" class="size-4 flex-none" />
            {label}
          </a>
        ))}
      </nav>
      {caveat && <p class="text-[0.8125rem] text-muted">{caveat}</p>}
    </div>

    <nav
      class="flex flex-col gap-2 border-l-2 border-line pl-4"
      aria-labelledby="toc-label"
    >
      <p id="toc-label" class="font-mono text-sm font-medium text-muted">
        on this page
      </p>
      <ol class="flex flex-col font-mono text-[0.8125rem]">
        {toc.map(({ slug, text }) => (
          <li>
            <a
              href={`#${slug}`}
              class="inline-block py-1 text-muted no-underline before:whitespace-pre before:text-line before:content-['#__'] hover:text-accent"
            >
              {text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  <article class="prose mt-12">
    <Content />
    {live.release && (
      <p>
        Latest release: <a href={live.release.url}>{live.release.tag}</a>
      </p>
    )}
    {changes.length > 0 && (
      <>
        <h2 id="recent-changes">Recent changes</h2>
        <ol class="flex flex-col gap-6">
          {changes.map(({ entry, Body }) => (
            <li class="flex flex-col gap-1">
              <p class="font-mono text-xs text-muted">
                <time datetime={isoDate(entry.data.date)}>
                  {isoDate(entry.data.date)}
                </time>
              </p>
              <p class="font-medium">
                {entry.data.href ? (
                  <a href={entry.data.href}>{entry.data.title}</a>
                ) : (
                  entry.data.title
                )}
              </p>
              <div class="prose">
                <Body />
              </div>
            </li>
          ))}
        </ol>
      </>
    )}
  </article>
</Base>
