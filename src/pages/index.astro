---
import AlsoLine from "../components/AlsoLine.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Base from "../layouts/Base.astro";
import { getProfile } from "../lib/profile";
import { getAlso, getCards, transitionNames } from "../lib/projects";

const profile = await getProfile();
const cards = await getCards();
const also = await getAlso();
---

<Base>
  <style
    is:inline
    slot="head"
    set:html={transitionNames(cards.map(({ id }) => id))}
  />
  <div class="flex flex-col gap-16">
    <Hero profile={profile} />
    <section
      id="projects"
      class="flex flex-col gap-5"
      aria-labelledby="projects-heading"
    >
      <h2
        id="projects-heading"
        class="font-mono text-sm font-medium text-muted"
      >
        projects
      </h2>
      <ul class="flex flex-col gap-4">
        {cards.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
      <AlsoLine projects={also} />
    </section>
  </div>
</Base>
