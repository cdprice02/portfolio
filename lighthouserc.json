{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm serve",
      "startServerReadyPattern": "Ready on",
      "url": ["http://localhost:8788/", "http://localhost:8788/404"],
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": ["robots-txt"],
        "chromeFlags": "--blink-settings=preferredColorScheme=1"
      }
    },
    "assert": {
      "assertions": {
        "csp-xss": ["error", { "minScore": 1 }],
        "errors-in-console": ["error", { "minScore": 1 }],
        "categories:performance": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 1, "aggregationMethod": "median-run" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 1, "aggregationMethod": "median-run" }
        ],
        "categories:seo": [
          "error",
          { "minScore": 1, "aggregationMethod": "median-run" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
