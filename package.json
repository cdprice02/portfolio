    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.0",
    "astro-icon": "^1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
